 <?
    function logItauShopLine($titulo,$dados, $idlog)
    {
        $quebra = chr(13).chr(10);
        $dados = $titulo.$quebra.'<pre>'.print_r($dados,1).'</pre>'.$quebra;       
            
        $abre = fopen('log-itaushopline/retorno-sonda/'.$idlog, 'a');
        $escreve = fwrite($abre, $quebra.$dados);
        fclose($abre);
    }  


    $filename = $_GET['i'];
    logItauShopLine('POST',$_POST, $filename);
    logItauShopLine('GET',$_GET, $filename);
    logItauShopLine('REQUEST de dados',$_REQUEST, $filename);
    logItauShopLine('SERVER',$_SERVER, $filename);
    header('Location: http://tihospedagem.com.br/pagamento/retorno/');