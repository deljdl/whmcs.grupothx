function moeda($valor){
    //$valor = str_replace('.',',',$valor);
    return number_format($valor, 2, ',', '');
}
function limitaCaracteres($str,$max,$sufixo='')
{
    if(strlen($str) > $max)
        $str=substr($str, 0, $max).$sufixo;
    return $str;
}
function logItauShopLine($titulo,$dados, $idlog)
{
    $quebra = chr(13).chr(10);
    $dados = $titulo.$quebra.'<pre>'.print_r($dados,1).'</pre>'.$quebra;

    $abre = fopen('log-itaushopline/'.$idlog, 'a');
    $escreve = fwrite($abre, $quebra.$dados);
    fclose($abre);
}
function erroItauShopline($erro)
{
    return '
    <div class="row" style="text-align:center">
        <h2>Desculpe</h2>
        <h1 style="font-size:95px; color:#BF0003"><i class="fa fa-thumbs-down" aria-hidden="true"></i></h1>
        <h2>Houve um erro ao gerar seu pagamento.</h2><br /><small style="color:#FFF">'.$erro.'</small>
    </div>';
}
function cpfCnpj($num)
{
    $retorno = array('tipo' => false, 'numero' => false);
    $numeros = preg_replace("/[^0-9]/", "", $num);

    $retorno['numero'] = $numeros;
    $digitos = strlen($numeros);
    if($digitos != 11 & $digitos != 14)
    {
        return false;
    }
    if($digitos == 11)
    {
        $retorno['tipo'] = '01';
    }
    else
    {
        $retorno['tipo'] = '02';
    }

    return $retorno;
}


