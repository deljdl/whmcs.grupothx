	@-webkit-keyframes animate-stripes {
  to {
    background-position: 0 0;
  }

  from {
    background-position: 44px 0;
  }
}

.atendimento_ativo{
	position:fixed; 
	bottom:-800px; 
	box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.1), 0px 0px 8px rgba(82, 168, 236, 0.6);
	border-radius: 3px 3px 3px 3px;
	left:10px;
	 cursor:pointer;
	 border-bottom-left-radius:100px;
	border-top-right-radius:100px;
	-webkit-animation:atendimento_ativo 10s; /* Chrome, Safari, Opera */
	animation:atendimento_ativo 10s;
	animation-fill-mode:forwards;
	-webkit-animation-fill-mode:forwards;
	transition: box-shadow 5s ease;
     -webkit-transition: box-shadow 5s ease;
     -o-transition:box-shadow 5s ease;
     -moz-transition: box-shadow 5s ease; 
}

/* Chrome, Safari, Opera */
@-webkit-keyframes atendimento_ativo
{

100% {left:10px; bottom:198px;}
}

/* Standard syntax */
@keyframes atendimento_ativo
{

100% {left:10px; bottom:198px;}
}

.atendimento_ativo:hover{
	box-shadow: 0px 1px 3px #F00, 0px 0px 8px #F00;
	 

}

.logo_tih{
	max-width:350px;
	float:left;
}



	@-webkit-keyframes pendura {
		from {
			-webkit-transform: rotate(0deg);
		}
		to {
			-webkit-transform: rotate(95deg);
		}
	}
	
	




	@-moz-keyframes pendura {
		from {
			-moz-transform: rotate(0deg);
		}
		to {
			-moz-transform: rotate(95deg);
		}
	}
	
	



.pendura {
	margin-left:150px;
	-webkit-transform: rotate(0deg);
	-webkit-transform-origin: 0px 0px;

	-moz-transform: rotate(0deg);
	-moz-transform-origin: 10px 10px;

	-o-transform: rotate(0deg);
	-o-transform-origin: 10px 10px;

	-webkit-animation: pendura 2s alternate ease infinite;
	-moz-animation: pendura 2s alternate ease infinite;
	-o-animation: pendura 2s alternate ease infinite;

}

.pendura:hover {-webkit-animation-play-state:paused;}

	












	</style>
